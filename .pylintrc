# Only the settings that differ from pylint's defaults.
# See all options and their defaults with: pylint --generate-rcfile

[MAIN]
jobs=4
# Django generates migrations. pylint-django tries to skip them, but that only works
# when `ignore` is set here, so we set it ourselves.
ignore=migrations

[DESIGN]
max-args=7
max-parents=14
min-public-methods=0

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    invalid-name,
    no-member,
    fixme,
    import-error,
    too-many-locals,
    no-name-in-module,
    too-many-instance-attributes,
    logging-fstring-interpolation,
    relative-beyond-top-level,
    broad-exception-raised,
